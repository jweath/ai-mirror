MIRROR_DB_PATH=data/mirror.db
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
MIRROR_ADMIN_TOKEN=
MIRROR_PUBLIC_URL=http://127.0.0.1:8000
MIRROR_SEND_ENABLED=false
MIRROR_BACKGROUND_ENABLED=true
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Fine-grained token: read-only Contents and Issues for explicitly registered repositories.
GITHUB_TOKEN=
# Extractive digest works without any model account. OpenAI is an explicit opt-in.
MIRROR_DIGEST_PROVIDER=extractive
OPENAI_API_KEY=
OPENAI_MODEL=
