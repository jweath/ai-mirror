MIRROR_DB_PATH=data/mirror.db
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
MIRROR_ADMIN_TOKEN=
MIRROR_PUBLIC_URL=http://127.0.0.1:8000
MIRROR_SEND_ENABLED=false
MIRROR_BACKGROUND_ENABLED=true
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Legacy single-owner token: read-only Contents and Issues. Prefer the App for multiple owners.
GITHUB_TOKEN=
# A GitHub App installed by each owner on selected project repositories.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Explicit private channel with only the instructor and AI Mirror bot.
MIRROR_REHEARSAL_CHANNEL_ID=
# Extractive digest works without any model account. OpenAI is an explicit opt-in.
MIRROR_DIGEST_PROVIDER=extractive
OPENAI_API_KEY=
OPENAI_MODEL=

# Read-only prep/reflection projection from the existing participation service
COURSE_LEARNING_URL=https://participation-api-production.up.railway.app/learning/snapshot
COURSE_LEARNING_TOKEN=
